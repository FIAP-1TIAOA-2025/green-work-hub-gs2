# Configuração do Banco de Dados PostgreSQL
# No macOS, o usuário padrão geralmente é seu nome de usuário do sistema
# Se você instalou PostgreSQL com Homebrew, pode não ter usuário 'postgres'
# Use: psql -l para verificar usuários disponíveis

DB_HOST=localhost
DB_PORT=5432
DB_NAME=greenworkhub
DB_USER=postgres
# Alternativa para macOS: DB_USER=$(whoami)
DB_PASSWORD=postgres
# Se não tiver senha, deixe vazio: DB_PASSWORD=

